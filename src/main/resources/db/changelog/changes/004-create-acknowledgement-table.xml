<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Compliance needs the exact date/time of every acknowledgement for reporting, this is an append-only history table.
    -->
    <changeSet id="004-create-reality-check-acknowledgement" author="assignment">
        <createTable tableName="reality_check_acknowledgement">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="session_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="acknowledged_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="reality_check_acknowledgement" indexName="idx_reality_check_ack_player">
            <column name="player_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>